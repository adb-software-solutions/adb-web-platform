FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter ./sites/admin-adb-software-solutions...
RUN if [ -f sites/admin-adb-software-solutions/.ci.env ]; then cp sites/admin-adb-software-solutions/.ci.env sites/admin-adb-software-solutions/.env.production; fi
RUN pnpm --dir sites/admin-adb-software-solutions build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=builder /app/sites/admin-adb-software-solutions/public ./public
COPY --from=builder /app/sites/admin-adb-software-solutions/.next ./.next
COPY --from=builder /app/sites/admin-adb-software-solutions/package.json ./package.json
COPY --from=builder /app/sites/admin-adb-software-solutions/node_modules ./node_modules
COPY --from=builder /app/sites/admin-adb-software-solutions/next.config.js ./next.config.js
USER nextjs
EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-p", "3000"]
