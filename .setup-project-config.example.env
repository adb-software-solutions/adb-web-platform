# Project Setup Configuration - Example
# This is an example configuration file for the setup-project script
# To use: Copy this file to .setup-project-config.env and customize, then run:
#   ./tools/setup-project .setup-project-config.env

# ============================================================================
# Project Information
# ============================================================================

# Application display name (e.g., "My Awesome App")
APP_NAME="My Awesome App"

# Python module name (lowercase, underscores, e.g., "my_awesome_app")
PYTHON_NAME="my_awesome_app"

# Slug name for URLs and Docker (lowercase, hyphens, e.g., "my-awesome-app")
SLUG_NAME="my-awesome-app"

# ============================================================================
# Database Configuration
# ============================================================================

# Database name
DB_NAME="myapp_dev"

# Database user
DB_USER="myapp_user"

# Database password
DB_PASSWORD="secure_password_here"

# ============================================================================
# Git Configuration
# ============================================================================

# GitHub upstream repository (where PRs are merged, e.g., "https://github.com/org/repo.git")
GITHUB_UPSTREAM="https://github.com/myorg/my-awesome-app.git"

# GitHub origin repository (your fork, e.g., "https://github.com/username/repo.git")
# Leave empty if you don't have a fork
GITHUB_ORIGIN=""

# ============================================================================
# Port Configuration
# ============================================================================

# Backend Django API port
BACKEND_PORT="8000"

# Website (Next.js) port
WEBSITE_PORT="3000"

# Auth Frontend (React/Vite) port
AUTH_FRONTEND_PORT="5173"

# PostgreSQL database port
POSTGRES_PORT="5432"

# Redis cache port
REDIS_PORT="6379"

# ============================================================================
# Extra Frontends (Optional)
# ============================================================================

# Space-separated list of extra frontend folder names
# Example: "admin-frontend docs-frontend customer-portal"
EXTRA_FRONTENDS_STR="admin-frontend docs"

# Space-separated list of frontend types (vite or nextjs)
# Must match the order of EXTRA_FRONTENDS_STR
# Example: "vite nextjs vite"
EXTRA_FRONTEND_TYPES_STR="vite nextjs"

# Space-separated list of ports for extra frontends
# Ports are assigned sequentially if not specified (starting from 5174)
# Leave empty to auto-assign
EXTRA_FRONTEND_PORTS_STR=""

# ============================================================================
# Celery Configuration (Optional)
# ============================================================================

# Configure Celery? (Y/n)
CONFIGURE_CELERY="Y"

# Comma-separated list of Celery queue names
# Example: "general,email,notifications,background"
CELERY_QUEUES="general,email,background"
