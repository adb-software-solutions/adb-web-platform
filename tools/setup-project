        name: Trivy FS Scan ($FRONTEND_DISPLAY_NAME)
        runs-on: ubuntu-latest
        steps:
            - uses: actions/checkout@v4
            - name: Run Trivy FS Scan
              uses: aquasecurity/trivy-action@master
              with:
                  scan-type: fs
                  severity: HIGH,CRITICAL
                  output: trivy-fs-scan.txt
              env:
                  TRIVY_DB_REPOSITORY: ghcr.io/aquasecurity/trivy-db,public.ecr.aws/aquasecurity/trivy-db
                  TRIVY_JAVA_DB_REPOSITORY: ghcr.io/aquasecurity/trivy-java-db,public.ecr.aws/aquasecurity/trivy-java-db
            - uses: actions/upload-artifact@v4
              with:
                  name: trivy-fs-scan-${frontend}
                  path: trivy-fs-scan.txt

    run-linters:
        name: Run Linters (root tools/lint)
        runs-on: ubuntu-latest
        steps:
            - uses: actions/checkout@v4
              with:
                  ref: \${{ github.event.pull_request.head.sha }}

            - uses: pnpm/action-setup@v4.1.0

            - uses: actions/setup-node@v4
              with:
                  node-version: "22"
                  cache: "pnpm"
                  cache-dependency-path: |
                      pnpm-lock.yaml
                      $frontend/pnpm-lock.yaml

            - name: Install root Node deps
              run: pnpm install --frozen-lockfile

            - name: Install website Node deps
              working-directory: website
              run: pnpm install --frozen-lockfile

            - name: Install auth-frontend Node deps
              working-directory: auth-frontend
              run: pnpm install --frozen-lockfile

            - name: Install $frontend Node deps
              working-directory: $frontend
              run: pnpm install --frozen-lockfile

            - name: Add node bin paths to PATH
              run: |
                  echo "\$GITHUB_WORKSPACE/node_modules/.bin" >> \$GITHUB_PATH
                  echo "\$GITHUB_WORKSPACE/$frontend/node_modules/.bin" >> \$GITHUB_PATH

            - uses: actions/setup-python@v5
              with:
                  python-version: "3.12"

            - name: Install Python tooling deps
              run: pip install -r backend/requirements/dev.txt

            - name: Install Shell tooling
              run: |
                  tools/setup/install-shellcheck
                  tools/setup/install-shfmt

            - name: Fetch main for comparison
              run: git fetch origin main

            - name: Run all linters (root)
              run: tools/lint

    run-tests:
        name: Run Tests
        runs-on: ubuntu-latest
        steps:
            - uses: actions/checkout@v4

            - uses: pnpm/action-setup@v4.1.0

