                    -t registry.digitalocean.com/adbsoftwaresolutions/${SLUG_NAME}-${frontend}:\${{ steps.meta.outputs.tag_suffix }} \\
                    .
            - name: Push Docker Image
              run: docker push registry.digitalocean.com/adbsoftwaresolutions/${SLUG_NAME}-${frontend}:\${{ steps.meta.outputs.tag_suffix }}

