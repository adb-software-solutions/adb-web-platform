#!/usr/bin/env bash
#
# setup-project - Initialize the ADB Software Solutions with your custom values
#
# This script will replace all generic placeholder values with your
# specific project configuration.
#
# Usage:
#   ./tools/setup-project              # Interactive mode
#   ./tools/setup-project config.env   # Load from config file (resumes from last completed step)
#

set -Eeuo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get the project root directory (parent of tools/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Progress tracking file
PROGRESS_FILE="$PROJECT_ROOT/.setup-progress"

# ============================================================================
# Step tracking functions
# ============================================================================

# Check if a step has been completed
step_completed() {
	local step_name="$1"
	if [[ -f "$PROGRESS_FILE" ]]; then
		grep -q "^$step_name$" "$PROGRESS_FILE" 2>/dev/null
		return $?
	fi
	return 1
}

# Mark a step as completed
mark_step_complete() {
	local step_name="$1"
	echo "$step_name" >>"$PROGRESS_FILE"
}

# Run a step if not already completed
run_step() {
	local step_num="$1"
	local step_name="$2"
	local step_desc="$3"

	if step_completed "$step_name"; then
		echo -e "${BLUE}[$step_num/12]${NC} $step_desc... ${GREEN}(already done, skipping)${NC}"
		return 1 # Return 1 to indicate step was skipped
	fi

	echo -e "${BLUE}[$step_num/12]${NC} $step_desc..."
	return 0 # Return 0 to indicate step should run
}

# Default config file location
DEFAULT_CONFIG_FILE="$PROJECT_ROOT/.setup-project-config.env"

echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║           ADB Software Solutions Setup Script                    ║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Check for config file argument or auto-detect
CONFIG_FILE="${1:-}"
LOAD_FROM_CONFIG=false

# Ensure extra frontend arrays are initialized (avoid unbound variables with set -u)
EXTRA_FRONTENDS=()
EXTRA_FRONTEND_TYPES=()
EXTRA_FRONTEND_PORTS=()

# If no config file passed, check if default exists
if [[ -z "$CONFIG_FILE" && -f "$DEFAULT_CONFIG_FILE" ]]; then
	echo -e "${YELLOW}Found existing configuration file: $DEFAULT_CONFIG_FILE${NC}"
	if [[ -f "$PROGRESS_FILE" ]]; then
		COMPLETED_STEPS=$(wc -l <"$PROGRESS_FILE" | tr -d ' ')
		echo -e "${YELLOW}Previous progress: $COMPLETED_STEPS/11 steps completed${NC}"
	fi
	echo ""
	read -p "Would you like to (R)esume with existing config or (S)tart fresh? [R/s]: " -r RESUME_CHOICE
	if [[ ! $RESUME_CHOICE =~ ^[Ss]$ ]]; then
		CONFIG_FILE="$DEFAULT_CONFIG_FILE"
		echo -e "${GREEN}Resuming with existing configuration...${NC}"
		echo ""
	else
		echo -e "${CYAN}Starting fresh configuration...${NC}"
		rm -f "$DEFAULT_CONFIG_FILE" "$PROGRESS_FILE"
		echo ""
	fi
fi

if [[ -n "$CONFIG_FILE" ]]; then
	if [[ -f "$CONFIG_FILE" ]]; then
		echo -e "${GREEN}Loading configuration from: $CONFIG_FILE${NC}"
		# shellcheck source=/dev/null
		source "$CONFIG_FILE"
		LOAD_FROM_CONFIG=true

		# Rebuild arrays from space-separated strings if present
		if [[ -n "${EXTRA_FRONTENDS_STR:-}" ]]; then
			IFS=' ' read -ra EXTRA_FRONTENDS <<<"$EXTRA_FRONTENDS_STR"
		else
			EXTRA_FRONTENDS=()
		fi
		if [[ -n "${EXTRA_FRONTEND_TYPES_STR:-}" ]]; then
			IFS=' ' read -ra EXTRA_FRONTEND_TYPES <<<"$EXTRA_FRONTEND_TYPES_STR"
		else
			EXTRA_FRONTEND_TYPES=()
		fi
		if [[ -n "${EXTRA_FRONTEND_PORTS_STR:-}" ]]; then
			IFS=' ' read -ra EXTRA_FRONTEND_PORTS <<<"$EXTRA_FRONTEND_PORTS_STR"
		else
			EXTRA_FRONTEND_PORTS=()
		fi
		echo ""
	else
		echo -e "${RED}Error: Config file not found: $CONFIG_FILE${NC}"
		exit 1
	fi
fi

# Check if already configured
if [[ -f "$PROJECT_ROOT/.project-configured" ]]; then
	echo -e "${YELLOW}⚠️  This project appears to already be configured.${NC}"
	read -p "Do you want to reconfigure? This may cause issues. (y/N): " -r
	if [[ ! $REPLY =~ ^[Yy]$ ]]; then
		echo "Aborting."
		exit 0
	fi
	# Reset progress if reconfiguring
	rm -f "$PROGRESS_FILE"
fi

if [[ "$LOAD_FROM_CONFIG" == "false" ]]; then
	# ============================================================================
	# Collect user input
	# ============================================================================
	echo -e "${GREEN}Please provide the following information:${NC}"
	echo ""

	# App Name (display name)
	read -p "App Name (e.g., 'ADB Software Solutions'): " APP_NAME
	if [[ -z "$APP_NAME" ]]; then
		echo -e "${RED}Error: App Name is required${NC}"
		exit 1
	fi

	# App Name for Python (module name, lowercase, no spaces/special chars)
	read -p "App Name for Python (e.g., 'adbsoftwaresolutions'): " PYTHON_NAME
	if [[ -z "$PYTHON_NAME" ]]; then
		echo -e "${RED}Error: Python App Name is required${NC}"
		exit 1
	fi

	# Validate Python name
	if [[ ! "$PYTHON_NAME" =~ ^[a-z][a-z0-9_]*$ ]]; then
		echo -e "${RED}Error: Python name must start with a lowercase letter and contain only lowercase letters, numbers, and underscores${NC}"
		exit 1
	fi

	# GitHub URLs
	read -p "GitHub URL for upstream (e.g., 'git@github.com:org/repo.git'): " GITHUB_UPSTREAM
	read -p "GitHub URL for origin (e.g., 'git@github.com:you/repo.git'): " GITHUB_ORIGIN

	# Slug version (for URLs, docker images, etc.)
	SLUG_NAME=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g')

	# Database name (use python name)
	DB_NAME="${PYTHON_NAME}_dev"
	DB_USER="${PYTHON_NAME}"
	DB_PASSWORD="${PYTHON_NAME}_dev_password"

	# ============================================================================
	# Port Configuration
	# ============================================================================
	echo ""
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo -e "${GREEN}Port Configuration:${NC}"
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo ""

	read -p "Backend port [default: 8000]: " BACKEND_PORT
	BACKEND_PORT="${BACKEND_PORT:-8000}"

	read -p "Website (Next.js) port [default: 3000]: " WEBSITE_PORT
	WEBSITE_PORT="${WEBSITE_PORT:-3000}"

	read -p "Auth Frontend (Vite) port [default: 5173]: " AUTH_FRONTEND_PORT
	AUTH_FRONTEND_PORT="${AUTH_FRONTEND_PORT:-5173}"

	read -p "PostgreSQL port [default: 5432]: " POSTGRES_PORT
	POSTGRES_PORT="${POSTGRES_PORT:-5432}"

	read -p "Redis port [default: 6379]: " REDIS_PORT
	REDIS_PORT="${REDIS_PORT:-6379}"

	# ============================================================================
	# Celery Configuration
	# ============================================================================
	echo ""
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo -e "${GREEN}Celery Configuration (Optional):${NC}"
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo ""
	echo -e "Celery is a distributed task queue for handling background jobs."
	echo ""

	read -p "Do you want to configure Celery? (y/n): " CONFIGURE_CELERY
	CONFIGURE_CELERY="${CONFIGURE_CELERY:-n}"

	if [[ "$CONFIGURE_CELERY" =~ ^[Yy]$ ]]; then
		echo ""
		echo "Enter Celery queue names (comma-separated):"
		echo "Example: general,email,notifications"
		read -p "Queue names: " CELERY_QUEUES

		if [[ -z "$CELERY_QUEUES" ]]; then
			echo -e "${YELLOW}⚠ No queues specified, Celery will not be configured${NC}"
			CONFIGURE_CELERY="n"
		else
			read -p "Enter Flower monitoring port [default: 5555]: " FLOWER_PORT
			FLOWER_PORT="${FLOWER_PORT:-5555}"
		fi
	else
		CELERY_QUEUES=""
		FLOWER_PORT="5555"
	fi

	# ============================================================================
	# Additional Frontends
	# ============================================================================
	echo ""
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo -e "${GREEN}Additional Frontends:${NC}"
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo ""
	echo -e "You can add extra frontend applications (e.g., admin-frontend, docs-frontend)"
	echo -e "Press Enter with no name when done adding frontends."
	echo ""

	# Use parallel arrays instead of associative arrays (for bash 3.x compatibility)
	EXTRA_FRONTENDS=()
	EXTRA_FRONTEND_TYPES=()
	EXTRA_FRONTEND_PORTS=()

	NEXT_VITE_PORT=$((AUTH_FRONTEND_PORT + 1))
	NEXT_NEXTJS_PORT=$((WEBSITE_PORT + 1))

	while true; do
		read -p "Frontend name (e.g., 'admin-frontend') or Enter to finish: " FRONTEND_NAME
		if [[ -z "$FRONTEND_NAME" ]]; then
			break
		fi

		# Validate frontend name
		if [[ ! "$FRONTEND_NAME" =~ ^[a-z][a-z0-9-]*$ ]]; then
			echo -e "${RED}Error: Frontend name must start with a lowercase letter and contain only lowercase letters, numbers, and hyphens${NC}"
			continue
		fi

		# Check if directory already exists
		if [[ -d "$PROJECT_ROOT/$FRONTEND_NAME" ]]; then
			echo -e "${RED}Error: Directory '$FRONTEND_NAME' already exists${NC}"
			continue
		fi

		echo -e "  Select framework:"
		echo -e "    1) Next.js"
		echo -e "    2) React/Vite"
		read -p "  Choice [1/2]: " FRAMEWORK_CHOICE

		case "$FRAMEWORK_CHOICE" in
		1)
			FRONTEND_TYPE="nextjs"
			read -p "  Port [default: $NEXT_NEXTJS_PORT]: " FRONTEND_PORT
			FRONTEND_PORT="${FRONTEND_PORT:-$NEXT_NEXTJS_PORT}"
			NEXT_NEXTJS_PORT=$((FRONTEND_PORT + 1))
			;;
		2 | *)
			FRONTEND_TYPE="vite"
			read -p "  Port [default: $NEXT_VITE_PORT]: " FRONTEND_PORT
			FRONTEND_PORT="${FRONTEND_PORT:-$NEXT_VITE_PORT}"
			NEXT_VITE_PORT=$((FRONTEND_PORT + 1))
			;;
		esac

		EXTRA_FRONTENDS+=("$FRONTEND_NAME")
		EXTRA_FRONTEND_TYPES+=("$FRONTEND_TYPE")
		EXTRA_FRONTEND_PORTS+=("$FRONTEND_PORT")
		echo -e "  ${GREEN}✓ Added $FRONTEND_NAME ($FRONTEND_TYPE) on port $FRONTEND_PORT${NC}"
		echo ""
	done

fi # End of LOAD_FROM_CONFIG check

# Build FRONTEND_DIRS list for tools/lint
FRONTEND_DIRS_LIST='"website"'
FRONTEND_DIRS_LIST+=',\n        "auth-frontend"'
for frontend in "${EXTRA_FRONTENDS[@]:-}"; do
	FRONTEND_DIRS_LIST+=",\n        \"$frontend\""
done

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}Configuration Summary:${NC}"
echo -e "  App Name:        ${YELLOW}$APP_NAME${NC}"
echo -e "  Python Name:     ${YELLOW}$PYTHON_NAME${NC}"
echo -e "  Slug Name:       ${YELLOW}$SLUG_NAME${NC}"
echo -e "  Database Name:   ${YELLOW}$DB_NAME${NC}"
echo -e "  Database User:   ${YELLOW}$DB_USER${NC}"
echo -e "  GitHub Upstream: ${YELLOW}${GITHUB_UPSTREAM:-'(not set)'}${NC}"
echo -e "  GitHub Origin:   ${YELLOW}${GITHUB_ORIGIN:-'(not set)'}${NC}"
echo ""
echo -e "${GREEN}Ports:${NC}"
echo -e "  Backend:         ${YELLOW}$BACKEND_PORT${NC}"
echo -e "  Website:         ${YELLOW}$WEBSITE_PORT${NC}"
echo -e "  Auth Frontend:   ${YELLOW}$AUTH_FRONTEND_PORT${NC}"
echo -e "  PostgreSQL:      ${YELLOW}$POSTGRES_PORT${NC}"
echo -e "  Redis:           ${YELLOW}$REDIS_PORT${NC}"
if [[ "$CONFIGURE_CELERY" =~ ^[Yy]$ ]] && [[ -n "$CELERY_QUEUES" ]]; then
	echo -e "  Flower:          ${YELLOW}$FLOWER_PORT${NC}"
fi
if [[ ${#EXTRA_FRONTENDS[@]} -gt 0 ]]; then
	echo ""
	echo -e "${GREEN}Extra Frontends:${NC}"
	for i in "${!EXTRA_FRONTENDS[@]}"; do
		echo -e "  ${EXTRA_FRONTENDS[$i]}: ${YELLOW}${EXTRA_FRONTEND_TYPES[$i]} on port ${EXTRA_FRONTEND_PORTS[$i]}${NC}"
	done
fi
if [[ "$CONFIGURE_CELERY" =~ ^[Yy]$ ]] && [[ -n "$CELERY_QUEUES" ]]; then
	echo ""
	echo -e "${GREEN}Celery:${NC}"
	echo -e "  Queues:          ${YELLOW}$CELERY_QUEUES${NC}"
fi
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

read -p "Proceed with these settings? (y/N): " -r
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
	echo "Aborting."
	exit 0
fi

# ============================================================================
# Save configuration to file for reuse
# ============================================================================
CONFIG_SAVE_FILE="$PROJECT_ROOT/.setup-project-config.env"
echo -e "${BLUE}Saving configuration to $CONFIG_SAVE_FILE${NC}"

# Convert arrays to space-separated strings for saving
EXTRA_FRONTENDS_STR="${EXTRA_FRONTENDS[*]:-}"
EXTRA_FRONTEND_TYPES_STR="${EXTRA_FRONTEND_TYPES[*]:-}"
EXTRA_FRONTEND_PORTS_STR="${EXTRA_FRONTEND_PORTS[*]:-}"

cat >"$CONFIG_SAVE_FILE" <<CONFIGEOF
# Project Setup Configuration
# Generated on $(date)
# To reuse: ./tools/setup-project $CONFIG_SAVE_FILE

APP_NAME="$APP_NAME"
PYTHON_NAME="$PYTHON_NAME"
SLUG_NAME="$SLUG_NAME"
DB_NAME="$DB_NAME"
DB_USER="$DB_USER"
DB_PASSWORD="$DB_PASSWORD"
GITHUB_UPSTREAM="$GITHUB_UPSTREAM"
GITHUB_ORIGIN="$GITHUB_ORIGIN"

# Ports
BACKEND_PORT="$BACKEND_PORT"
WEBSITE_PORT="$WEBSITE_PORT"
AUTH_FRONTEND_PORT="$AUTH_FRONTEND_PORT"
POSTGRES_PORT="$POSTGRES_PORT"
REDIS_PORT="$REDIS_PORT"

# Extra frontends (space-separated)
EXTRA_FRONTENDS_STR="$EXTRA_FRONTENDS_STR"
EXTRA_FRONTEND_TYPES_STR="$EXTRA_FRONTEND_TYPES_STR"
EXTRA_FRONTEND_PORTS_STR="$EXTRA_FRONTEND_PORTS_STR"

# Celery configuration
CONFIGURE_CELERY="$CONFIGURE_CELERY"
CELERY_QUEUES="$CELERY_QUEUES"
FLOWER_PORT="$FLOWER_PORT"
CONFIGEOF

echo -e "  ${GREEN}✓ Configuration saved. If setup fails, rerun with:${NC}"
echo -e "    ${YELLOW}./tools/setup-project $CONFIG_SAVE_FILE${NC}"
echo ""

echo ""
echo -e "${GREEN}🚀 Starting project configuration...${NC}"
echo ""

# Function to replace text in files
replace_in_file() {
	local file="$1"
	local search="$2"
	local replace="$3"

	if [[ -f "$file" ]]; then
		if grep -q "$search" "$file" 2>/dev/null; then
			if [[ "$OSTYPE" == "darwin"* ]]; then
				sed -i '' "s|$search|$replace|g" "$file"
			else
				sed -i "s|$search|$replace|g" "$file"
			fi
		fi
	fi
}

# Function to replace text in all matching files
replace_in_files() {
	local search="$1"
	local replace="$2"
	local pattern="${3:-*}"

	# Find files with common extensions
	local files
	files=$(find "$PROJECT_ROOT" -type f \( -name "*.py" -o -name "*.ts" -o -name "*.tsx" -o -name "*.js" \
		-o -name "*.json" -o -name "*.yaml" -o -name "*.yml" -o -name "*.md" -o -name "*.html" \
		-o -name "*.txt" -o -name "*.sh" -o -name "*.toml" -o -name "*.cfg" -o -name "*.ini" \
		-o -name "Dockerfile*" -o -name "*.jsonc" -o -name "*.env*" -o -name "*.css" \) \
		! -path "*/node_modules/*" ! -path "*/.git/*" ! -path "*/__pycache__/*" \
		! -path "*/.next/*" ! -path "*/dist/*" ! -path "*/build/*" \
		! -path "*/coverage/*" ! -path "*/.venv/*" ! -path "*/venv/*" \
		! -path "*/.mypy_cache/*" ! -path "*/.pnpm-store/*" ! -path "*/.ruff_cache/*" \
		! -path "*/.swc/*" ! -name ".eslintcache" \
		-exec grep -l "$search" {} \; 2>/dev/null) || true

	if [[ -n "$files" ]]; then
		echo "$files" | while read -r file; do
			if [[ "$OSTYPE" == "darwin"* ]]; then
				sed -i '' "s|$search|$replace|g" "$file"
			else
				sed -i "s|$search|$replace|g" "$file"
			fi
		done
	fi

	# Also check executable scripts in tools/ directory (no extension)
	local tool_files
	if [[ "$OSTYPE" == "darwin"* ]]; then
		tool_files=$(find "$PROJECT_ROOT/tools" -maxdepth 1 -type f -perm +111 \
			-exec grep -l "$search" {} \; 2>/dev/null) || true
	else
		tool_files=$(find "$PROJECT_ROOT/tools" -maxdepth 1 -type f -executable \
			-exec grep -l "$search" {} \; 2>/dev/null) || true
	fi

	if [[ -n "$tool_files" ]]; then
		echo "$tool_files" | while read -r file; do
			if [[ "$OSTYPE" == "darwin"* ]]; then
				sed -i '' "s|$search|$replace|g" "$file"
			else
				sed -i "s|$search|$replace|g" "$file"
			fi
		done
	fi

	# Also check executable scripts in .devcontainer/scripts/ directory (no extension)
	local devcontainer_files
	if [[ -d "$PROJECT_ROOT/.devcontainer/scripts" ]]; then
		if [[ "$OSTYPE" == "darwin"* ]]; then
			devcontainer_files=$(find "$PROJECT_ROOT/.devcontainer/scripts" -maxdepth 1 -type f -perm +111 \
				-exec grep -l "$search" {} \; 2>/dev/null) || true
		else
			devcontainer_files=$(find "$PROJECT_ROOT/.devcontainer/scripts" -maxdepth 1 -type f -executable \
				-exec grep -l "$search" {} \; 2>/dev/null) || true
		fi

		if [[ -n "$devcontainer_files" ]]; then
			echo "$devcontainer_files" | while read -r file; do
				if [[ "$OSTYPE" == "darwin"* ]]; then
					sed -i '' "s|$search|$replace|g" "$file"
				else
					sed -i "s|$search|$replace|g" "$file"
				fi
			done
		fi
	fi
}

# ============================================================================
# Step 1: Rename Django module folder
# ============================================================================
if run_step "1" "step_1_django_rename" "Renaming Django module folder"; then

	DJANGO_OLD="$PROJECT_ROOT/backend/app"
	DJANGO_NEW="$PROJECT_ROOT/backend/$PYTHON_NAME"

	if [[ -d "$DJANGO_NEW" ]]; then
		# Destination already exists (possibly from a previous failed run)
		if [[ -d "$DJANGO_OLD" ]]; then
			# Both exist - old has the template, new is leftover
			echo -e "  ${YELLOW}⚠ Destination folder backend/$PYTHON_NAME already exists${NC}"
			echo -e "  ${YELLOW}  (This can happen if you reverted git changes after a previous run)${NC}"
			read -p "  Remove existing backend/$PYTHON_NAME and proceed? (y/N): " -r
			if [[ $REPLY =~ ^[Yy]$ ]]; then
				rm -rf "$DJANGO_NEW"
				mv "$DJANGO_OLD" "$DJANGO_NEW"
				echo "  ✓ Removed old folder and renamed backend/app → backend/$PYTHON_NAME"
			else
				echo -e "  ${RED}Cannot proceed with existing destination folder. Please resolve manually.${NC}"
				exit 1
			fi
		else
			# Only new exists - already renamed in previous run
			echo "  ✓ backend/$PYTHON_NAME already exists (from previous run)"
		fi
	elif [[ -d "$DJANGO_OLD" ]]; then
		mv "$DJANGO_OLD" "$DJANGO_NEW"
		echo "  ✓ Renamed backend/app → backend/$PYTHON_NAME"
	else
		echo -e "  ${YELLOW}⚠ backend/app not found, skipping folder rename${NC}"
	fi

	mark_step_complete "step_1_django_rename"
fi

# ============================================================================
# Step 2: Update Django module imports and references
# ============================================================================
if run_step "2" "step_2_django_imports" "Updating Django module references"; then

	# These are specific patterns we created - not generic "app" usage
	# Django settings module references
	replace_in_files "app\.settings" "${PYTHON_NAME}.settings"
	replace_in_files "app\.asgi" "${PYTHON_NAME}.asgi"
	replace_in_files "app\.wsgi" "${PYTHON_NAME}.wsgi"
	replace_in_files "app\.urls" "${PYTHON_NAME}.urls"
	replace_in_files "app\.ninja" "${PYTHON_NAME}.ninja"
	replace_in_files "app\.asgi_handler_logging" "${PYTHON_NAME}.asgi_handler_logging"
	replace_in_files "app\.asgi_middleware" "${PYTHON_NAME}.asgi_middleware"

	# Import statements with 'from adbsoftwaresolutions.'
	replace_in_files "from app\." "from ${PYTHON_NAME}."
	replace_in_files "import app\." "import ${PYTHON_NAME}."

	echo "  ✓ Updated Django module imports"
	mark_step_complete "step_2_django_imports"
fi

