                  image-ref: registry.digitalocean.com/adbsoftwaresolutions/${SLUG_NAME}-${frontend}:\${{ steps.meta.outputs.tag_suffix }}
                  severity: HIGH,CRITICAL
                  output: trivy-image-scan.txt
              env:
                  TRIVY_USERNAME: \${{ secrets.DO_REGISTRY_USERNAME }}
                  TRIVY_PASSWORD: \${{ secrets.DO_REGISTRY_ACCESS_TOKEN }}
            - uses: actions/upload-artifact@v4
              with:
                  name: trivy-docker-image-scan-${frontend}
                  path: trivy-image-scan.txt
