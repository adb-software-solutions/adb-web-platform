        branches: ["main"]
        tags: ["*"]
        paths:
            - "$frontend/**"
            - "$DOCKERFILE_NAME"
            - ".github/workflows/${frontend}-ci.yml"
            - "tools/**"
            - "pnpm-lock.yaml"
            - "package.json"
    pull_request:
        paths:
            - "$frontend/**"
            - "$DOCKERFILE_NAME"
            - ".github/workflows/${frontend}-ci.yml"
            - "tools/**"
            - "pnpm-lock.yaml"
            - "package.json"
    workflow_dispatch:

