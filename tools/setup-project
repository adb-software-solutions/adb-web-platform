			--frontends "$FRONTENDS_LIST"; then
			echo "Error: Failed to update tasks.json" >&2
			exit 1
		fi
	fi

	echo "  ✓ Updated lint config and VS Code tasks"
	mark_step_complete "step_11_lint_tasks"
fi

# ============================================================================
# Step 12: Configure Celery (if requested)
# ============================================================================
if run_step "12" "step_12_celery" "Configuring Celery"; then

	if [[ "$CONFIGURE_CELERY" =~ ^[Yy]$ ]] && [[ -n "$CELERY_QUEUES" ]]; then
		echo "  Configuring Celery with queues: $CELERY_QUEUES"

		# Call the Python script to set up Celery
		if ! python3 "$PROJECT_ROOT/tools/setup-celery.py" \
			--project-root "$PROJECT_ROOT" \
			--app-name "$APP_NAME" \
			--python-name "$PYTHON_NAME" \
			--slug-name "$SLUG_NAME" \
			--queues "$CELERY_QUEUES" \
			--flower-port "$FLOWER_PORT"; then
			echo "Error: Failed to configure Celery" >&2
			exit 1
		fi

		# Update post-create.sh with Flower info
		POSTCREATE_FILE="$PROJECT_ROOT/.devcontainer/post-create.sh"
		if [[ -f "$POSTCREATE_FILE" ]]; then
			# Add Flower to Quick start commands
			if ! grep -q "Flower:" "$POSTCREATE_FILE"; then
				if [[ "$OSTYPE" == "darwin"* ]]; then
					sed -i '' "/echo \"  Backend:/a\\
echo \"  Flower:          cd /workspace/backend && source /opt/venv/bin/activate && celery -A $PYTHON_NAME flower --port=$FLOWER_PORT --address=0.0.0.0\"
" "$POSTCREATE_FILE"
				else
					sed -i "/echo \"  Backend:/a\\
echo \"  Flower:          cd /workspace/backend && source /opt/venv/bin/activate && celery -A $PYTHON_NAME flower --port=$FLOWER_PORT --address=0.0.0.0\"" "$POSTCREATE_FILE"
				fi
			fi

			# Add Flower to Access URLs
			if ! grep -q "Flower:" "$POSTCREATE_FILE"; then
				if [[ "$OSTYPE" == "darwin"* ]]; then
					sed -i '' "/echo \"  Django Admin:/a\\
echo \"  Flower:          http://localhost:$FLOWER_PORT/\"
" "$POSTCREATE_FILE"
				else
					sed -i "/echo \"  Django Admin:/a\\
echo \"  Flower:          http://localhost:$FLOWER_PORT/\"" "$POSTCREATE_FILE"
				fi
			fi
		fi

		# Update devcontainer.json with Flower port
		echo "  Updating devcontainer.json with Flower port..."
		DEVCONTAINER_FILE="$PROJECT_ROOT/.devcontainer/devcontainer.json"
		if [[ -f "$DEVCONTAINER_FILE" ]]; then
			# Build extra frontends argument for Python script
			EXTRA_FRONTENDS_ARG=""
			NEXT_PORT=5174
			for frontend in "${EXTRA_FRONTENDS[@]:-}"; do
				# Convert frontend name to label (e.g., admin-frontend -> Admin Frontend)
				LABEL=$(echo "$frontend" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')

				if [[ -z "$EXTRA_FRONTENDS_ARG" ]]; then
					EXTRA_FRONTENDS_ARG="${frontend}:${NEXT_PORT}:${LABEL}"
				else
					EXTRA_FRONTENDS_ARG="${EXTRA_FRONTENDS_ARG},${frontend}:${NEXT_PORT}:${LABEL}"
				fi
				NEXT_PORT=$((NEXT_PORT + 1))
			done

			# Re-run Python script to update devcontainer.json with Flower port
			python3 "$PROJECT_ROOT/tools/update-devcontainer-ports.py" \
				--devcontainer-path "$DEVCONTAINER_FILE" \
				--backend-port "$BACKEND_PORT" \
				--website-port "$WEBSITE_PORT" \
				--auth-frontend-port "$AUTH_FRONTEND_PORT" \
				--postgres-port "$POSTGRES_PORT" \
				--extra-frontends "$EXTRA_FRONTENDS_ARG" \
				--flower-port "$FLOWER_PORT"
		fi

		echo "  ✓ Celery configuration complete"
	else
		echo "  ⊘ Celery not configured"
	fi

	mark_step_complete "step_12_celery"
fi

