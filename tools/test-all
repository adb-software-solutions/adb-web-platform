#!/bin/bash
set -u

echo "Running all application tests..."
echo ""

FAILED_COMPONENTS=()

run_test() {
	local name="$1"
	shift

	echo "Testing ${name}..."
	if "$@"; then
		echo "${name} tests passed"
	else
		echo "${name} tests failed"
		FAILED_COMPONENTS+=("${name}")
	fi
	echo ""
}

run_test "Backend" bash -c 'cd backend && DJANGO_SETTINGS_MODULE=adbsoftwaresolutions.settings_test coverage run manage.py test -v 2'
run_test "ADB Software Solutions" pnpm --dir sites/adb-software-solutions test --passWithNoTests
run_test "ADB Web Designs" pnpm --dir sites/adb-web-designs test --passWithNoTests
run_test "ADB Technology" pnpm --dir sites/adb-technology test --passWithNoTests
run_test "ADB Software Solutions Auth" pnpm --dir sites/auth-adb-software-solutions test --passWithNoTests

if [ ${#FAILED_COMPONENTS[@]} -eq 0 ]; then
	echo "All tests passed."
	exit 0
fi

echo "Failed components: ${FAILED_COMPONENTS[*]}"
exit 1
