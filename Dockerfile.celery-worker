# Use official Python base image with slimmed down Debian base
FROM python:3.12-slim

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=C.UTF-8 \
    LOG_FORMAT=json \
    SERVICE_NAME=adb-web-platform-celery-worker

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    curl \
    iputils-ping \
    libffi-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    libcairo2 \
    libcairo2-dev \
    fontconfig \
    # WeasyPrint dependencies for PDF generation
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements/dev.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Set working directory
WORKDIR /opt/adb-software-solutions

# Copy project code (backend directory contents)
COPY ./backend/ .

COPY ./entrypoint-celery-worker.sh /entrypoint-celery-worker.sh
RUN chmod +x /entrypoint-celery-worker.sh

# Run as www-data (uid/gid 33), the user nginx runs as on the host: the
# static and media bind mounts belong to it, and nginx serves what the
# application writes there. The code stays root-owned and read-only to
# the application; it writes only to the mounts, /tmp and its home
# (/var/www, for library caches).
RUN install -d -o www-data -g www-data -m 0755 /var/www
USER www-data

ENTRYPOINT [ "/entrypoint-celery-worker.sh" ]
