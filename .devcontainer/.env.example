# Local development template. Copy to .devcontainer/.env BEFORE opening the container.
# Full setup, variable sources and production overrides: ../README.md#setup-and-configuration
# Never commit .env, encryption keys, passwords or private keys.

# Core backend. Generate SECRET_KEY and CREDENTIAL_ENCRYPTION_KEYS using the README commands.
DEBUG=1
DEBUG_TOOLBAR_ENABLED=0
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEYS=
SITE_DOMAIN=localhost
ADMIN_FRONTEND_URL=http://localhost:3000
AUTH_FRONTEND_URL=http://localhost:3004
SOFTWARE_SOLUTIONS_FRONTEND_URL=http://localhost:3000
WEB_DESIGNS_FRONTEND_URL=http://localhost:3002
TECHNOLOGY_FRONTEND_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000

# PostgreSQL: these local values match docker-compose.yml. Use managed credentials in production.
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=adbsoftwaresolutions_dev
SQL_USER=adbsoftwaresolutions
SQL_PASSWORD=adbsoftwaresolutions_dev_password
SQL_HOST=db
SQL_PORT=5432
SQL_SSL=disable

# Cache + SSE share redis-cache. Sessions are separate; broker/results use Celery Redis DBs 0/1.
CACHE_BACKEND_URL=redis://redis-cache:6379/0
SESSION_BACKEND_URL=redis://redis-session:6379/0
CELERY_BROKER_URL=redis://redis-celery:6379/0
CELERY_RESULT_BACKEND=redis://redis-celery:6379/1
CELERY_QUEUE=general
CELERY_CONCURRENCY=2

# Application emails share the Infisical Microsoft Graph connection below.
# This sending address must be a Shared Mailbox within the app's Exchange scope.
DEFAULT_FROM_EMAIL=no-reply@adbsoftwaresolutions.co.uk

# Microsoft Graph: injected by Infisical into API/worker environments, never copied to the app Vault.
# The app discovers this connection directly from runtime values; no bootstrap command.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_PRIVATE_KEY=
MICROSOFT_GRAPH_CERTIFICATE=
MICROSOFT_GRAPH_PRIVATE_KEY_PASSPHRASE=
# Optional Graph scheduling overrides:
TICKETING_GRAPH_SYNC_INTERVAL_SECONDS=60
TICKETING_GRAPH_SYNC_LOCK_SECONDS=900

# Optional attachment scanner. Enable only when a ClamAV service is available.
TICKETING_MALWARE_SCANNING_ENABLED=0
TICKETING_CLAMAV_HOST=clamav
TICKETING_CLAMAV_PORT=3310
TICKETING_CLAMAV_TIMEOUT_SECONDS=30

# Optional GitHub dashboard. Get App ID/slug from GitHub App settings.
# Inject the complete signing PEM through Infisical; literal \n escapes are also supported.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Public frontend settings: available to all pnpm processes in the container. No secrets here.
# API URL is the backend ORIGIN, without /api or a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_WEB_DESIGNS_URL=http://localhost:3002
NEXT_PUBLIC_TECHNOLOGY_URL=http://localhost:3003

# Optional server-to-server backend URL for public SSR/CMS and contact submissions.
# Set at frontend runtime (not NEXT_PUBLIC); use your private API origin in production.
API_INTERNAL_URL=http://localhost:8000
# Optional production backend overrides for private SSR routing (not needed in local dev).
# Exact private service hostnames, comma separated; no scheme, port or wildcard.
INTERNAL_API_HOSTS=
# Publicly reachable absolute media base with trailing slash, e.g. https://api.example.com/media/.
# Leave unset or blank to use /media/; this local example preserves the default.
PUBLIC_MEDIA_URL=/media/
