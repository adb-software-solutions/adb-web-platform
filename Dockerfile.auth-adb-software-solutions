FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter ./sites/auth-adb-software-solutions...
RUN if [ -f sites/auth-adb-software-solutions/.ci.env ]; then cp sites/auth-adb-software-solutions/.ci.env sites/auth-adb-software-solutions/.env.production; fi
RUN pnpm --dir sites/auth-adb-software-solutions build

FROM node:22-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app /app
EXPOSE 3004
CMD ["pnpm", "--dir", "sites/auth-adb-software-solutions", "start"]
