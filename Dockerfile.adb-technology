FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter ./sites/adb-technology...
RUN pnpm --dir sites/adb-technology build

FROM node:22-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app /app
EXPOSE 3000
CMD ["pnpm", "--dir", "sites/adb-technology", "start", "-p", "3000"]
