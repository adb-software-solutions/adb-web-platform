# Stage 1: Build the internal admin Next.js app
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY ./admin-website/package.json ./admin-website/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY ./admin-website .

# Optional: include only if you're using env vars at build time
COPY ./admin-website/.ci.env .env.production

RUN pnpm run build && rm -f .env

# Stage 2: Serve the Next.js app with Node.js
FROM node:22-alpine AS runner

ENV NODE_ENV=production

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

WORKDIR /app

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/next.config.js ./next.config.js

USER nextjs

EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
