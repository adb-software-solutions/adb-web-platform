            "dependsOn": [
                "Start Backend",
                "Start Admin",
                "Start Auth",
                "Start ADB Software Solutions",
                "Start ADB Web Designs",
                "Start ADB Technology"
            ],
            "dependsOrder": "parallel",
            "group": "build"
        },
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "start-backend",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Admin",
            "type": "shell",
            "command": "pnpm dev:admin",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Auth",
            "type": "shell",
            "command": "pnpm dev:auth",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start ADB Software Solutions",
            "type": "shell",
            "command": "pnpm dev:software-solutions",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start ADB Web Designs",
            "type": "shell",
            "command": "pnpm dev:web-designs",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start ADB Technology",
            "type": "shell",
            "command": "pnpm dev:technology",
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Lint Code",
            "type": "shell",
            "command": "tools/lint",
            "group": "test"
        },
        {
            "label": "Lint and Fix Code",
            "type": "shell",
            "command": "tools/lint --fix",
            "group": "test"
        },
        {
            "label": "Test All",
            "type": "shell",
            "command": "tools/test-all",
            "group": "test"
        },
        {
            "label": "Django Shell",
            "type": "shell",
            "command": "cd /workspace/backend && source /opt/venv/bin/activate && python manage.py shell",
            "group": "build"
        },
        {
            "label": "Start All Celery Workers",
