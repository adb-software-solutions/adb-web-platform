{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8000",
                "--nothreading",
                "--noreload"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "adbsoftwaresolutions.settings"
            },
            "django": true,
            "justMyCode": true,
            "python": "/opt/venv/bin/python"
        },
        {
            "name": "Django: Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": ["test"],
            "env": {
                "DJANGO_SETTINGS_MODULE": "adbsoftwaresolutions.settings_test"
            },
            "django": true,
            "justMyCode": true,
            "python": "/opt/venv/bin/python",
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}
